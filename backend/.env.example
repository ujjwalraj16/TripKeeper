# ── Application settings ──────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# A long, random secret used to sign JWTs.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme_generate_a_real_secret

# JWT algorithm (keep HS256 unless you have a good reason to change)
ALGORITHM=HS256

# Token expiry in minutes (default: 60 minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SQLite database file path (relative to the backend/ directory)
DATABASE_URL=sqlite+aiosqlite:///./tripkeeper.db

# ── Ollama (AI) ───────────────────────────────────────────────────────────────
# Base URL of your local Ollama instance
OLLAMA_HOST=http://localhost:11434

# Model to use for AI features (must be pulled: ollama pull qwen2.5:7b)
OLLAMA_MODEL=qwen2.5:7b

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the frontend
CORS_ORIGINS=http://localhost:3000
